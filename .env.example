# ===== Desktop =====
# Copy to .env (cp .env.example .env). Both ./run.sh and the service (fedora-remote) read it when they start.

# Where the server listens, on this computer only (127.0.0.1). Seraph's Caddyfile
# (~/dev/github_searcher/remote_access/Caddyfile) passes /desktop* here: change it there too.
DESKTOP_PORT=8020

# Seraph's settings: its remote access domain (where the phone opens the desktop) and its data folder (the
# passkeys of its devices, which sign in here too).
SERAPH_ENV=~/seraph/.env

# The desktop's own data: its sign in sessions (sessions.json).
DATA_DIR=data

# How long a phone stays signed in before Face ID again.
SESSION_DAYS=7

# ===== Screen =====
# The picture's quality when the server starts: low (1280 wide), medium (1920) or high (the screen's own size).
# The phone's Quality menu changes it while it runs.
QUALITY=medium
MAX_FPS=30

# The virtual monitor's size, used when no monitor is on (the laptop's lid closed).
VIRTUAL_SIZE=1920x1200

# Screen sharing stops this long after the last phone closes the page.
STOP_SECONDS=10

# ===== Terminal =====
# The tmux session the Terminal page opens (and keeps, between visits).
TERMINAL_SESSION=phone
